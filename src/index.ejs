<%
const baseUrl = '.';
const characterMap = new Map(
    characters.map(chara => [
        chara.unit_id,
        chara
    ])
);
%>

<%-
    include('./_inc/_head.ejs', {
        baseUrl: baseUrl
    });
%>

<script
    id="skill-finder-index"
    type="application/json"
><%- jsonForHtml(skillFinderIndex) %></script>

<div class="finder-search">
    <label class="search-box">
        <span class="search-label">検索</span>
        <input
            id="skill-search"
            type="search"
            autocomplete="off"
            placeholder="キャラ名・スキル名・効果"
        >
    </label>

    <button
        id="clear-filters"
        class="clear-filters"
        type="button"
    >
        条件クリア
    </button>
</div>

<%- include('./_inc/_buttons.ejs', { characters }) %>

<div class="finder-toolbar">
    <div
        class="sort-tabs"
        role="tablist"
        aria-label="並び替え"
    >
        <button
            class="sort-tab active"
            type="button"
            role="tab"
            aria-selected="true"
            data-sort="release"
        >
            リリース順
        </button>

        <button
            class="sort-tab"
            type="button"
            role="tab"
            aria-selected="false"
            data-sort="rare"
        >
            レアリティ
        </button>

        <button
            class="sort-tab"
            type="button"
            role="tab"
            aria-selected="false"
            data-sort="kana"
        >
            50音
        </button>
    </div>

    <div class="toolbar-meta">
        <label class="view-switch">
            <input
                type="checkbox"
                id="raw-view-toggle"
                checked
            >
            <span
                class="view-switch-track"
                aria-hidden="true"
            ></span>
            <span>原文</span>
        </label>

        <div
            class="result-count"
            aria-live="polite"
        >
            <span id="visible-count"><%= skillFinderIndex.length %></span>
            /
            <span id="total-count"><%= skillFinderIndex.length %></span>
        </div>
    </div>
</div>

<div
    id="empty-result"
    class="empty-result"
    hidden
>
    該当するスキルがありません
</div>

<div
    id="skill-list"
    class="skill-list"
>
    <% for (let skill of skills) { %>
        <%
        const chara = characterMap.get(skill.unit_id);
        %>

        <% if (chara) { %>
            <%- include(
                "_inc/_card",
                {
                    skill,
                    chara,
                    accessories
                }
            ) %>
        <% } %>
    <% } %>
</div>

<script>
(() => {
    const indexElement =
        document.getElementById('skill-finder-index');

    const listElement =
        document.getElementById('skill-list');

    const countElement =
        document.getElementById('visible-count');

    const searchInput =
        document.getElementById('skill-search');

    const clearFiltersButton =
        document.getElementById('clear-filters');

    const emptyResultElement =
        document.getElementById('empty-result');

    const tabs = [
        ...document.querySelectorAll('.sort-tab')
    ];

    const filterButtons = [
        ...document.querySelectorAll('[data-filter-group]')
    ];

    const characterScopeButtons = [
        ...document.querySelectorAll('[data-character-scope-toggle]')
    ];

    const rawViewToggle =
        document.getElementById('raw-view-toggle');

    const skillIndex =
        JSON.parse(indexElement.textContent);

    const cardMap = new Map(
        [...document.querySelectorAll('[data-skill-id]')]
            .map(card => [
                card.dataset.skillId,
                card
            ])
    );

    const skillTypeOrder = {
        EX1: 1,
        'EX1+': 2,
        EX2: 3,
        'EX2+': 4
    };

    const compareNumber = (a, b) =>
        (a ?? Number.MAX_SAFE_INTEGER)
        - (b ?? Number.MAX_SAFE_INTEGER);

    const compareText = (a, b) =>
        String(a ?? '').localeCompare(
            String(b ?? ''),
            'ja'
        );

    const compareSkillType = (a, b) =>
        compareNumber(
            skillTypeOrder[a.skill_type],
            skillTypeOrder[b.skill_type]
        );

    const compareSkillId = (a, b) =>
        String(a.skill_id).localeCompare(
            String(b.skill_id),
            'ja',
            {
                numeric: true
            }
        );

    const compareRelease = (a, b) =>
        compareNumber(a.release_order, b.release_order)
        || compareNumber(a.unit_id, b.unit_id)
        || compareSkillType(a, b)
        || compareSkillId(a, b);

    const compareRare = (a, b) =>
        compareNumber(b.rarity, a.rarity)
        || compareRelease(a, b);

    const compareKana = (a, b) =>
        compareText(a.character_name_kana, b.character_name_kana)
        || compareText(a.character_name, b.character_name)
        || compareRelease(a, b);

    const comparers = {
        release: compareRelease,
        rare: compareRare,
        kana: compareKana
    };

    const activeFilters = new Map();
    const sortedItemsCache = new Map();

    const STORAGE_KEY = 'twinkle_skill_finder_state';

    let currentSortKey = 'release';
    let characterScopeMode = false;
    let scheduledRenderFrame = 0;
    let scheduledRenderTimer = 0;

    const getActiveValues = (group) =>
        activeFilters.get(group) || new Set();

    const hasAnyValue = (itemValues, activeValues) => {
        const values =
            Array.isArray(itemValues)
                ? itemValues.map(String)
                : [String(itemValues)];

        return values.some(value =>
            activeValues.has(value)
        );
    };

    const matchesSkillGroup = (item) => {
        const activeValues =
            getActiveValues('skill_group');

        if (
            activeValues.size === 0
            || activeValues.has('all')
        ) {
            return true;
        }

        if (activeValues.has('ex1')) {
            return item.skill_type === 'EX1'
                || item.skill_type === 'EX1+';
        }

        if (activeValues.has('ex2')) {
            return item.skill_type === 'EX2'
                || item.skill_type === 'EX2+';
        }

        return true;
    };

    const matchesFilters = (item) => {
        if (!matchesSkillGroup(item)) {
            return false;
        }

        for (const [group, activeValues] of activeFilters) {
            if (
                group === 'skill_group'
                || activeValues.size === 0
            ) {
                continue;
            }

            if (!hasAnyValue(item[group], activeValues)) {
                return false;
            }
        }

        return true;
    };

    const normalizeSearchText = (value) =>
        String(value ?? '').trim().toLowerCase();

    const matchesSearch = (item) => {
        const query =
            normalizeSearchText(searchInput.value);

        if (!query) {
            return true;
        }

        return String(item.search_text || '').includes(query);
    };

    const matchesCurrentConditions = (item) =>
        matchesFilters(item)
        && matchesSearch(item);

    const updateCharacterScopeToggle = () => {
        characterScopeButtons.forEach(button => {
            const active =
                button.dataset.characterScopeValue
                === (characterScopeMode ? 'character' : 'skill');

            button.classList.toggle('active', active);
            button.setAttribute(
                'aria-pressed',
                active ? 'true' : 'false'
            );
        });
    };

    const updateFilterButton = (button, active) => {
        button.classList.toggle('active', active);
        button.setAttribute(
            'aria-pressed',
            active ? 'true' : 'false'
        );
    };

    const setSingleFilter = (group, value) => {
        activeFilters.set(
            group,
            new Set([value])
        );

        filterButtons
            .filter(button =>
                button.dataset.filterGroup === group
            )
            .forEach(button =>
                updateFilterButton(
                    button,
                    button.dataset.filterValue === value
                )
            );
    };

    const toggleMultiFilter = (button) => {
        const group =
            button.dataset.filterGroup;

        const value =
            button.dataset.filterValue;

        const values =
            new Set(getActiveValues(group));

        if (values.has(value)) {
            values.delete(value);
        } else {
            values.add(value);
        }

        if (values.size === 0) {
            activeFilters.delete(group);
        } else {
            activeFilters.set(group, values);
        }

        updateFilterButton(
            button,
            values.has(value)
        );
    };

    const setActiveTab = (sortKey) => {
        tabs.forEach(tab => {
            const active =
                tab.dataset.sort === sortKey;

            tab.classList.toggle('active', active);
            tab.setAttribute(
                'aria-selected',
                active ? 'true' : 'false'
            );
        });
    };

    const getSortedItems = (sortKey) => {
        if (!sortedItemsCache.has(sortKey)) {
            const comparer =
                comparers[sortKey] || compareRelease;

            sortedItemsCache.set(
                sortKey,
                [...skillIndex].sort(comparer)
            );
        }

        return sortedItemsCache.get(sortKey);
    };

    const render = (sortKey = currentSortKey) => {
        currentSortKey = sortKey;

        const fragment =
            document.createDocumentFragment();

        const sortedItems =
            getSortedItems(sortKey);

        const matchedUnitIds = new Set();
        const visibleSkillIds = new Set();

        for (const item of skillIndex) {
            if (matchesCurrentConditions(item)) {
                matchedUnitIds.add(item.unit_id);
                visibleSkillIds.add(item.skill_id);
            }
        }

        if (characterScopeMode) {
            for (const item of skillIndex) {
                if (matchedUnitIds.has(item.unit_id)) {
                    visibleSkillIds.add(item.skill_id);
                }
            }
        }

        let visibleCount = 0;

        for (const item of sortedItems) {
            const card =
                cardMap.get(item.skill_id);

            if (card) {
                const visible =
                    visibleSkillIds.has(item.skill_id);

                card.hidden = !visible;

                if (visible) {
                    visibleCount++;
                }

                fragment.appendChild(card);
            }
        }

        listElement.appendChild(fragment);
        countElement.textContent = visibleCount;
        emptyResultElement.hidden = visibleCount !== 0;
        setActiveTab(sortKey);
    };

    const scheduleRender = (sortKey = currentSortKey) => {
        currentSortKey = sortKey;
        setActiveTab(sortKey);

        if (scheduledRenderFrame) {
            cancelAnimationFrame(scheduledRenderFrame);
        }

        if (scheduledRenderTimer) {
            clearTimeout(scheduledRenderTimer);
        }

        scheduledRenderFrame = requestAnimationFrame(() => {
            scheduledRenderFrame = 0;

            scheduledRenderTimer = setTimeout(() => {
                scheduledRenderTimer = 0;
                render(currentSortKey);
                saveState();
            }, 0);
        });
    };

    const serializeFilters = () =>
        Object.fromEntries(
            [...activeFilters].map(([group, values]) => [
                group,
                [...values]
            ])
        );

    const saveState = () => {
        localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({
                sort: currentSortKey,
                filters: serializeFilters(),
                search: searchInput.value,
                raw: rawViewToggle.checked,
                characterScope: characterScopeMode
            })
        );
    };

    const applyFilterButtons = () => {
        filterButtons.forEach(button => {
            const values =
                getActiveValues(button.dataset.filterGroup);

            updateFilterButton(
                button,
                values.has(button.dataset.filterValue)
            );
        });
    };

    const syncControlsFromState = () => {
        applyFilterButtons();
        updateCharacterScopeToggle();
        updateViewToggles();
        setActiveTab(currentSortKey);
    };

    const restoreState = () => {
        const rawState =
            localStorage.getItem(STORAGE_KEY);

        if (!rawState) {
            setSingleFilter('skill_group', 'all');
            syncControlsFromState();
            return;
        }

        try {
            const state =
                JSON.parse(rawState);

            activeFilters.clear();

            for (const [group, values] of Object.entries(state.filters || {})) {
                if (Array.isArray(values) && values.length) {
                    activeFilters.set(
                        group,
                        new Set(values.map(String))
                    );
                }
            }

            if (!getActiveValues('skill_group').size) {
                activeFilters.set(
                    'skill_group',
                    new Set(['all'])
                );
            }

            searchInput.value =
                state.search || "";

            rawViewToggle.checked =
                state.raw !== false;

            characterScopeMode =
                state.characterScope === true;

            currentSortKey =
                comparers[state.sort]
                    ? state.sort
                    : 'release';

            syncControlsFromState();
        } catch {
            activeFilters.clear();
            searchInput.value = "";
            rawViewToggle.checked = true;
            setSingleFilter('skill_group', 'all');
            characterScopeMode = false;
            currentSortKey = 'release';
            syncControlsFromState();
        }
    };

    const resetFilters = () => {
        activeFilters.clear();
        searchInput.value = "";
        characterScopeMode = false;
        setSingleFilter('skill_group', 'all');
        syncControlsFromState();
        scheduleRender();
    };

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            scheduleRender(tab.dataset.sort);
        });
    });

    filterButtons.forEach(button => {
        button.addEventListener('click', () => {
            const group =
                button.dataset.filterGroup;

            const value =
                button.dataset.filterValue;

            if (group === 'skill_group') {
                setSingleFilter(group, value);
            } else {
                toggleMultiFilter(button);
            }

            scheduleRender();
        });
    });

    const updateViewToggles = () => {
        document.body.classList.toggle(
            'hide-raw',
            !rawViewToggle.checked
        );
    };

    rawViewToggle.addEventListener('change', () => {
        updateViewToggles();
        saveState();
    });

    searchInput.addEventListener('input', () => {
        scheduleRender();
    });

    clearFiltersButton.addEventListener('click', resetFilters);

    characterScopeButtons.forEach(button => {
        button.addEventListener('click', () => {
            characterScopeMode =
                button.dataset.characterScopeValue === 'character';

            updateCharacterScopeToggle();
            scheduleRender();
        });
    });

    restoreState();
    syncControlsFromState();
    render(currentSortKey);
})();
</script>

</body>
</html>
