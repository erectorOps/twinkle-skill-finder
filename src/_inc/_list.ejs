                    <li data-val="物理防御,魔法防御" data-check="0"><div><%- t("support-any-defence-plus") %></div></li>
                    <li data-val="物理クリティカル,魔法クリティカル" data-check="0"><div><%- t("support-any-critical-plus") %></div></li>
