                    <li data-val="イベント" data-check="0"><div><%- t("summon-event") %></div></li>
                    <li data-val="バーストフェス" data-check="0"><div><%- t("summon-burst-fes") %></div></li>
                    <li data-val="無限討伐戦" data-check="0"><div><%- t("summon-infinity-battle") %></div></li>
                    <li data-val="疾走討伐戦" data-check="0"><div><%- t("summon-rush-battle") %></div></li>
                    <li data-val="試練の塔" data-check="0"><div><%- t("summon-tower") %></div></li>
                    <li data-val="同盟戦" data-check="0"><div><%- t("summon-guild-war") %></div></li>
                    <li data-val="Fanzine" data-check="0"><div><%- t("summon-fanzine") %></div></li>
                    <li data-val="シーズンパス" data-check="0"><div><%- t("summon-season-pass") %></div></li>
