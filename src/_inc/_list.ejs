                <ul class="filter_container" data-filter="added_year" data-count="3">
                    <li data-val="2026" data-check="0"><div>2026</div></li>
                    <li data-val="2025" data-check="0"><div>2025</div></li>
                    <li data-val="2024" data-check="0"><div>2024</div></li>
