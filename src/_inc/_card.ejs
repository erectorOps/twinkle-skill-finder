<%

const bgImage =
  `img/unit/chara_${skill.unit_id}_2_1.png`;

const escapeHtml = (value) =>
  String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const renderFormula = (formula) =>
  escapeHtml(formula).replace(
    /\{([^{}]+)\}/g,
    '<span class="formula-group"><span class="formula-brace">{</span><span class="formula-body">$1</span><span class="formula-brace">}</span></span>'
  )
  .replace(
    /\+/g,
    '<span class="formula-op">+</span>'
  );

const skillAccessory =
  (accessories || []).find(x =>
    x.unit_id === skill.unit_id
  );

const accessoryAbilities =
  skillAccessory
    ? skillAccessory.acc_abilities
      .filter(ability =>
        ability.skill_type === "COMMON"
        || String(ability.skill_id) === String(skill.skill_id)
      )
    : [];

const accessoryCommonEffects =
  accessoryAbilities
    .filter(ability => ability.skill_type === "COMMON")
    .flatMap(ability => ability.effects || []);

const accessorySkillEffects =
  accessoryAbilities
    .filter(ability => ability.skill_type !== "COMMON")
    .flatMap(ability => ability.effects || []);

const accessoryRawTexts =
  accessoryAbilities
    .map(ability => {
      if (!ability.text) {
        return "";
      }

      return `${ability.skill_type}：${ability.text}`;
    })
    .filter(Boolean);

const renderAccessoryEffectSummary = (effect) => {
  const parts = [
    effect.type,
    effect.target,
    effect.display_value
  ].filter(Boolean);

  const body = escapeHtml(parts.join(" "));

  if (!effect.formula) {
    return body;
  }

  return `${body}<span class="accessory-common-formula">└ ${renderFormula(effect.formula)}</span>`;
};

let skillIcon = `img/skill_${String(skill.icon_id)}.png`;
  

if (skill.icon_id < 10000) {
    skillIcon = `img/skill_${String(skill.icon_id).padStart(4, "0")}.png`; 
}

const iconGroup = Math.floor(skill.icon_id / 100);

let skillTypeBg =
  "img/btn_skill_blank.png";

switch (iconGroup) {
    case 1:
        skillTypeBg =
            "img/btn_skill_attack.png";
        break;
    case 2:
        skillTypeBg =
            "img/btn_skill_knockback.png";
        break;
    case 3:
        skillTypeBg =
            "img/btn_skill_buff.png";
        break;
    case 4:
        skillTypeBg =
            "img/btn_skill_debuff.png";
        break;
    case 5:
        skillTypeBg =
            "img/btn_skill_status.png";
        break;
    case 6:
        skillTypeBg =
            "img/btn_skill_recovery.png";
        break;
    case 7:
        skillTypeBg =
            "img/btn_skill_special.png";
        break;
    case 30:
        skillTypeBg =
            "img/btn_skill_specific.png";
        break;
}

%>

<%

    let skill_type_label = "EXスキル1";
    let skill_type_css = "ex1"
    switch (skill.skill_type) {
        case "EX1":
            skill_type_label = "EXスキル1";
            skill_type_css = "ex1"
            break;
        case "EX2":
            skill_type_label = "EXスキル2";
            skill_type_css = "ex2"
            break;
        case "EX1+":
            skill_type_label = "EXスキル1+";
            skill_type_css = "ex1-plus"
            break;
        case "EX2+":
            skill_type_label = "EXスキル2+";
            skill_type_css = "ex2-plus"
            break;
    }

%>


<div class="skill-card <%= skill.skill_type.toLowerCase() %>">

  <div class="skill-header">

    <img
      class="skill-bg"
      src="<%= bgImage %>"
      alt=""
    >

    <div class="skill-badges">

      <% if (chara.affiliations.length > 0) { %>
      <div class="icon-with-ruby">
        <img
          src="img/<%= chara.affiliations[0].icon %>"
          alt="<%= chara.affiliations[0].label %>"
        >

        <span class="ruby">
          <%= chara.affiliations[0].label %>
        </span>
      </div>
      <% } %>

      <% if (chara.camps.length > 0) { %>
      <div class="icon-with-ruby">
        <img
          src="img/<%= chara.camps[0].icon %>"
          alt="<%= chara.camps[0].label %>"
        >

        <span class="ruby">
          <%= chara.camps[0].label %>
        </span>
      </div>
      <% } %>

      <% if (chara.sp_equip_types.length > 0) { %>
      <img
        class="icon-sp-equip-type"
        src="img/<%= chara.sp_equip_types[0].icon %>"
        alt=""
      >
      <% } %>

      <img
        src="img/<%= chara.role.icon %>"
        alt=""
      >

      <div class="icon-stack">
        <img
          class="icon-base"
          src="img/attribute_base.png"
          alt=""
        >

        <img
          class="icon-main"
          src="img/<%= chara.attr_type.icon %>"
          alt=""
        >
      </div>

    </div>

    <div class="skill-content">

      <div class="skill-type <%- skill_type_css %>">
        <%= skill_type_label %>
      </div>

      <div class="skill-main">

        <div
          class="skill-cover"
          style="
            background-image:
              url(<%= skillIcon %>),
              url(<%= skillTypeBg %>);
          "
        ></div>

        <div class="skill-meta">

          <div class="skill-name">
            <%= skill.name %>
          </div>

          <div class="skill-sub">
            <span class="cost-label">
              消費EX
            </span>

            <span class="cost-value">
              <%= skill.cost_ex_gauge %>
            </span>
          </div>

        </div>

      </div>

    </div>

  </div>

  <div class="effect-list">

    <div class="effect-box other">
      <div class="effect-top">
        <span class="effect-formula">
          <%- skill.skill_detail.replace(/\n/g, "<br>") %>
        </span>
      </div>
    </div>

    <% skill.effects.forEach(effect => { %>

    <div
      class="effect-box <%= effect.effect_class %>"
    >

      <div class="effect-top">

        <span class="effect-name">

          <%= effect.type %>

          <% if (effect.duration) { %>
          <span class="effect-ct">
            <%= effect.duration.ct %>CT
          </span>
          <% } %>

        </span>

        <% if (effect.target) { %>
        <span class="effect-target">
          <%= effect.target %>
        </span>
        <% } %>

      </div>

      <% if (effect.display_value) { %>
      <div class="effect-value">
        <%= effect.display_value %>
      </div>
      <% } %>

      <% if (effect.formula) { %>
      <div class="effect-formula">
        └ <%- renderFormula(effect.formula) %>
      </div>
      <% } %>

      <% if (effect.children && effect.children.length) { %>
      <div class="effect-children">
      <% effect.children.forEach(sub_effect => { %>
        <div class="effect-box sub-effect <%= sub_effect.effect_class %>">

          <div class="effect-top">

            <span class="effect-name">
              <%= sub_effect.type %>

              <% if (sub_effect.duration) { %>
              <span class="effect-ct">
                <%= sub_effect.duration.ct %>CT
              </span>
              <% } %>

            </span>

            <% if (sub_effect.target) { %>
            <span class="effect-target">
              <%= sub_effect.target %>
            </span>
            <% } %>

          </div>

          <% if (sub_effect.display_value) { %>
          <div class="effect-value">
            <%= sub_effect.display_value %>
          </div>
          <% } %>
          <% if (sub_effect.formula) { %>
          <div class="effect-formula">
            └ <%- renderFormula(sub_effect.formula) %>
          </div>
          <% } %>
          <% if (sub_effect.notes && sub_effect.notes.length) { %>
            <% sub_effect.notes.forEach(note => { %>
              <div class="effect-note <%= note.type %>">
                <span class="tag"><%= note.label %></span>
                <%= note.text %>
              </div>
            <% }) %>
          <% } %>
        </div>
      <% }) %>
      </div>
      <% } %>


      <% if (
        effect.notes
        && effect.notes.length
      ) { %>

        <% effect.notes.forEach(note => { %>

        <div
          class="
            effect-note
            <%= note.type %>
          "
        >

          <span class="tag">
            <%= note.label %>
          </span>

          <%= note.text %>

        </div>

        <% }) %>

      <% } %>

    </div>

    <% }) %>

    <% if (skillAccessory && (accessoryCommonEffects.length || accessorySkillEffects.length)) { %>

    <div class="effect-box accessory">

      <% if (skillAccessory.illust_id) { %>
      <img
        class="accessory-illust"
        src="img/equip/<%= skillAccessory.illust_id %>.png"
        alt=""
      >
      <% } %>

      <div class="effect-top">
        <span class="effect-name">
          <img
            class="effect-icon"
            src="img/icon_equipment_03.png"
            alt=""
          >
          <%= skillAccessory.accessory_name %>
        </span>
      </div>

      <% if (accessoryCommonEffects.length) { %>
      <div class="effect-value">
        <% accessoryCommonEffects.forEach(common_effect => { %>
        <div class="accessory-common-effect">
          <%- renderAccessoryEffectSummary(common_effect) %>
        </div>
        <% }) %>
      </div>
      <% } %>

      <% if (accessoryRawTexts.length || accessorySkillEffects.length) { %>
      <div class="effect-children">
        <% accessoryRawTexts.forEach(raw_text => { %>
        <div class="effect-box sub-effect other accessory-raw">
          <div class="effect-top">
            <span class="effect-formula">
              <%- escapeHtml(raw_text).replace(/\n/g, "<br>") %>
            </span>
          </div>
        </div>
        <% }) %>

        <% accessorySkillEffects.forEach(sub_effect => { %>
        <div class="effect-box sub-effect <%= sub_effect.effect_class %>">

          <div class="effect-top">

            <span class="effect-name">
              <%= sub_effect.type %>

              <% if (sub_effect.duration) { %>
              <span class="effect-ct">
                <%= sub_effect.duration.ct %>CT
              </span>
              <% } %>
            </span>

            <% if (sub_effect.target) { %>
            <span class="effect-target">
              <%= sub_effect.target %>
            </span>
            <% } %>

          </div>

          <% if (sub_effect.display_value) { %>
          <div class="effect-value">
            <%= sub_effect.display_value %>
          </div>
          <% } %>

          <% if (sub_effect.formula) { %>
          <div class="effect-formula">
            └ <%- renderFormula(sub_effect.formula) %>
          </div>
          <% } %>

          <% if (sub_effect.children && sub_effect.children.length) { %>
          <div class="effect-children">
            <% sub_effect.children.forEach(child_effect => { %>
            <div class="effect-box accessory<%= child_effect.effect_class && child_effect.effect_class !== "accessory" ? ` ${child_effect.effect_class}` : "" %>">

              <div class="effect-top">

                <span class="effect-name">
                  <%= child_effect.type %>

                  <% if (child_effect.duration) { %>
                  <span class="effect-ct">
                    <%= child_effect.duration.ct %>CT
                  </span>
                  <% } %>
                </span>

                <% if (child_effect.target) { %>
                <span class="effect-target">
                  <%= child_effect.target %>
                </span>
                <% } %>

              </div>

              <% if (child_effect.display_value) { %>
              <div class="effect-value">
                <%= child_effect.display_value %>
              </div>
              <% } %>

              <% if (child_effect.formula) { %>
              <div class="effect-formula">
                └ <%- renderFormula(child_effect.formula) %>
              </div>
              <% } %>

              <% if (child_effect.notes && child_effect.notes.length) { %>
                <% child_effect.notes.forEach(note => { %>
                  <div class="effect-note <%= note.type %>">
                    <span class="tag"><%= note.label %></span>
                    <%= note.text %>
                  </div>
                <% }) %>
              <% } %>

            </div>
            <% }) %>
          </div>
          <% } %>

          <% if (sub_effect.notes && sub_effect.notes.length) { %>
            <% sub_effect.notes.forEach(note => { %>
              <div class="effect-note <%= note.type %>">
                <span class="tag"><%= note.label %></span>
                <%= note.text %>
              </div>
            <% }) %>
          <% } %>

        </div>
        <% }) %>
      </div>
      <% } %>

    </div>

    <% } %>

  </div>

</div>
